{
  "name": "olx-imoveis-backend",
  "version": "1.0.0",
  "description": "Backend (API + scraper multi-plataforma + worker + bot Telegram) para busca e avaliação de imóveis (OLX, ZAP Imóveis)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/worker.js",
    "worker:dev": "node --watch src/worker.js"
  },
  "dependencies": {
    "axios": "^1.7.4",
    "axios-cookiejar-support": "^5.0.3",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "https-proxy-agent": "^7.0.5",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.66.0",
    "tough-cookie": "^4.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
