# Copie este arquivo para ".env" e preencha os valores.
# NUNCA versione o .env real (já está no .gitignore).

# --- Servidor ---
PORT=3000

# --- Onde os dados JSON ficam salvos (perfis, imóveis, logs) ---
# Caminho absoluto opcional; por padrão usa a pasta /data do projeto.
# DATA_DIR=/caminho/absoluto/para/data

# --- Scraper OLX ---
OLX_BASE_URL=https://www.olx.com.br
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
# Intervalo mínimo entre requisições (ms) — não reduza demais, risco de bloqueio
SCRAPER_REQUEST_DELAY_MS=2500
SCRAPER_MAX_PAGES_PER_RUN=3
SCRAPER_TIMEOUT_MS=15000

# --- Worker / agendamento (sintaxe cron padrão) ---
SCAN_CRON=*/10 * * * *
# Nota mínima (0-100) para notificar, caso o perfil não defina a própria
NOTIFY_MIN_SCORE=70

# --- Telegram ---
# Obtenha o token conversando com @BotFather no Telegram (veja README.md)
TELEGRAM_BOT_TOKEN=
# IDs de chat com permissão para /pausar e /retomar (separados por vírgula)
# Deixe vazio para não restringir.
TELEGRAM_ADMIN_CHAT_IDS=
